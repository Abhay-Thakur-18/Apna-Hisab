# --- BACKEND CONFIGURATION ---
# MongoDB Connection String (e.g., mongodb+srv://<username>:<password>@cluster.mongodb.net/apna_hisab)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DB_NAME=apna_hisab

# JWT Authentication Secret Key (Generate a secure key using: openssl rand -hex 32)
JWT_SECRET=supersecretjwtkey1234567890abcdefgh

# Token expiration time in minutes (default 30 days for mobile app convenience)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Backend Port (FastAPI)
PORT=8000
HOST=0.0.0.0

# --- GOOGLE OAUTH CONFIGURATION ---
# Client IDs generated from Google Developer Console
GOOGLE_CLIENT_ID_WEB=your-google-client-id-web.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-google-client-id-android.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=your-google-client-id-ios.apps.googleusercontent.com
